class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int index1 = 0;
        int index2 = 0;
        int index3 = 0;
        
        // Results
        int[] resultArr = new int[m + n];

        // Compare codes
        while (index1 < m && index2 < n) {
            if (nums1[index1] <= nums2[index2]) {
                resultArr[index3] = nums1[index1];
                index1++;
            } else {
                resultArr[index3] = nums2[index2];
                index2++;
            }
            index3++;
        }

        // Copy elements from nums1
        while (index1 < m) {
            resultArr[index3] = nums1[index1];
            index1++;
            index3++;
        }

        while (index2 < n) {
            resultArr[index3] = nums2[index2];
            index2++;
            index3++;
        }
        for (int i = 0; i < m + n; i++) {
            nums1[i] = resultArr[i];
        }
    }
}
